# Copy to .env for local development. Never commit the copied .env file.
# 로컬 개발용 예시입니다. 복사한 .env 파일은 커밋하지 마세요.
# 本文件仅用于本地开发示例，请勿提交复制后的 .env 文件。

POCKETEDGE_HOST=0.0.0.0
POCKETEDGE_PORT=8080
POCKETEDGE_PAIRING_REQUIRED=true

# Keep credentials server-side and inject them through your deployment secret store.
BACKEND_API_BASE_URL=https://api.example.com
BACKEND_API_TOKEN=replace-me-locally
